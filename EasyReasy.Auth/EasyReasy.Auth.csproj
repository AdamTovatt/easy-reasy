<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>A lightweight .NET library for internal JWT authentication and claims handling, with refresh token rotation, password hashing, TOTP primitives, WebAuthn/FIDO2 second-factor verification, query-string tokens for WebSocket connections and path-scoped cookie tokens for files opened in a new tab</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <PackageTags>auth;jwt;claims;mfa;totp;webauthn;fido2;passkey;websocket;easyreasy</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <VersionPrefix>5.14.0</VersionPrefix>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReleaseNotes>ExternalAuthResult gains FailureDetail, the provider package's own name for a refusal, set through a new four-parameter Failed overload; the existing Failed overload and ExternalAuthFailureReason are unchanged, so provider packages built against 5.13.1 run as before. TimeProviderLifetimeValidator is now public, so a TokenValidationParameters built for another issuer's tokens can check lifetime on the registered clock. Both are used by EasyReasy.Auth.Microsoft 1.0.0. See https://github.com/AdamTovatt/easy-reasy/blob/auth-v$(VersionPrefix)/EasyReasy.Auth/README.md#migration-from-5131</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyReasy.Auth.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WebAuthn types decode CBOR with System.Formats.Cbor, which needs no PackageReference: it
         ships inside the Microsoft.AspNetCore.App shared framework referenced below, so every consumer
         of this package already has it. Adding it as a package would put a dependency on the published
         nupkg that nothing resolves at runtime, which is what NU1510 reports. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <!-- JwtBearer brings JsonWebTokens, System.IdentityModel.Tokens.Jwt and the Protocols packages at an older
         version than Tokens, and a mixed IdentityModel set rejects every token this package issues (IDX14102).
         The family is therefore referenced here at one version, directly or through these references, so a
         consumer resolves an aligned set from this package alone. IdentityModelVersionAlignmentTests fails if they drift apart. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
