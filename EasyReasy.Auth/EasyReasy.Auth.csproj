<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>A lightweight .NET library for internal JWT authentication and claims handling, with refresh token rotation, password hashing, TOTP primitives, WebAuthn/FIDO2 second-factor and passkey sign-in verification, query-string tokens for WebSocket connections and path-scoped cookie tokens for files opened in a new tab</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <PackageTags>auth;jwt;claims;mfa;totp;webauthn;fido2;passkey;websocket;easyreasy</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <VersionPrefix>5.15.0</VersionPrefix>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReleaseNotes>Usernameless passkey sign-in (discoverable credentials), as a mode of its own beside the WebAuthn second factor: WebAuthnOptionsGenerator.CreateDiscoverableRegistrationOptions and CreateDiscoverableAuthenticationOptions, and WebAuthnVerifier.VerifyDiscoverableRegistration and VerifyDiscoverableAuthentication, which checks the assertion's user handle against the credential owner's, after the signature. User verification is always required in this mode. WebAuthnAuthenticationResult gains Mode (SecondFactor or Discoverable), and WebAuthnAuthenticationFailureReason gains UserHandleMissing and UserHandleMismatch. The second-factor methods keep their signatures and behaviour; only the message of the empty allow-list refusal changed, to point at the passkey method. See https://github.com/AdamTovatt/easy-reasy/blob/auth-v$(VersionPrefix)/EasyReasy.Auth/README.md#migration-from-5140</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyReasy.Auth.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WebAuthn types decode CBOR with System.Formats.Cbor, which needs no PackageReference: it
         ships inside the Microsoft.AspNetCore.App shared framework referenced below, so every consumer
         of this package already has it. Adding it as a package would put a dependency on the published
         nupkg that nothing resolves at runtime, which is what NU1510 reports. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <!-- JwtBearer brings JsonWebTokens, System.IdentityModel.Tokens.Jwt and the Protocols packages at an older
         version than Tokens, and a mixed IdentityModel set rejects every token this package issues (IDX14102).
         The family is therefore referenced here at one version, directly or through these references, so a
         consumer resolves an aligned set from this package alone. IdentityModelVersionAlignmentTests fails if they drift apart. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.19.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
