<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>A lightweight .NET library for internal JWT authentication and claims handling, with refresh token rotation, password hashing, TOTP primitives, WebAuthn/FIDO2 second-factor and passkey sign-in verification, query-string tokens for WebSocket connections, path-scoped cookie tokens for files opened in a new tab, and an OAuth 2.1 authorization server for MCP clients with app-owned consent</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <PackageTags>auth;jwt;claims;mfa;totp;webauthn;fido2;passkey;websocket;oauth;oauth2;mcp;pkce;easyreasy</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <VersionPrefix>5.20.0</VersionPrefix>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReleaseNotes>Adds StoreSweep, the hosted service the OAuth server's sweep is built on, now public: derive from it to delete expired rows from a store of your own every interval, each sweep in a scope of its own, a failure logged and retried the next interval. The OAuth server's sweep behaves as before. The IdentityModel packages (JsonWebTokens, Protocols.OpenIdConnect, Tokens, System.IdentityModel.Tokens.Jwt) move from 8.19.1 to 8.23.0 together, so EasyReasy.Auth.Saml's SAML library and this package resolve one aligned set; move any of the four you reference yourself to 8.23.0 too. Nothing is removed. See https://github.com/AdamTovatt/easy-reasy/blob/auth-v$(VersionPrefix)/EasyReasy.Auth/README.md#migration-from-5180</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyReasy.Auth.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WebAuthn types decode CBOR with System.Formats.Cbor, which needs no PackageReference: it
         ships inside the Microsoft.AspNetCore.App shared framework referenced below, so every consumer
         of this package already has it. Adding it as a package would put a dependency on the published
         nupkg that nothing resolves at runtime, which is what NU1510 reports. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <!-- JwtBearer brings JsonWebTokens, System.IdentityModel.Tokens.Jwt and the Protocols packages at an older
         version than Tokens, and a mixed IdentityModel set rejects every token this package issues (IDX14102).
         The family is therefore referenced here at one version, directly or through these references, so a
         consumer resolves an aligned set from this package alone. Packages built on this one take the family from
         here rather than referencing it again, so the version is set in this one place; it is kept at least at the
         version EasyReasy.Auth.Saml's ITfoxtec.Identity.Saml2 pulls Microsoft.IdentityModel.Tokens.Saml in at.
         IdentityModelVersionAlignmentTests fails if they drift apart. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
