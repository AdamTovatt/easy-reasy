<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth.Testing</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>Test helpers for apps built on EasyReasy.Auth: a software WebAuthn authenticator for testing passkey and security-key endpoints against the real verifier, and an OAuth test client with an in-memory store for driving the OAuth 2.1 authorization server end to end. For test projects only: never reference it from production code</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <PackageTags>auth;webauthn;fido2;passkey;oauth;mcp;testing;easyreasy</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <VersionPrefix>1.2.0</VersionPrefix>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReleaseNotes>InMemoryOAuthServerStore implements IOAuthServerStore.DeleteExpiredAsync: it deletes requests, codes and refresh tokens at or past their ExpiresAt, then the clients registered before the cutoff that nothing left names, as the server's sweep asks. Requires EasyReasy.Auth 5.18.0. See https://github.com/AdamTovatt/easy-reasy/blob/auth-testing-v$(VersionPrefix)/EasyReasy.Auth.Testing/README.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- System.Formats.Cbor ships inside the ASP.NET Core shared framework, as EasyReasy.Auth's csproj
         explains, so the CBOR writer needs no package reference of its own. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- No InternalsVisibleTo in either direction: this package builds on EasyReasy.Auth's public API
         alone, so a release of it is not tied to one EasyReasy.Auth build. -->
    <ProjectReference Include="..\EasyReasy.Auth\EasyReasy.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
