<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth.Client</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>Minimal client only library for EasyReasy.Auth</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <VersionPrefix>1.9.0</VersionPrefix>
    <PackageReleaseNotes>Adds SessionNotRenewableException, derived from InvalidOperationException, thrown when a client built from an AuthResponse has no refresh token left or the server refused it, so a caller can tell a spent session from any other InvalidOperationException. A refresh answered 408, 429 or 5xx now keeps the refresh token: a client with credentials signs in as before, and one without now throws HttpRequestException carrying the status where it used to throw InvalidOperationException. An unsuccessful sign-in other than 401 now sets HttpRequestException.StatusCode; a transport failure leaves it null. Calls waiting on authorization share one failed sign-in or refresh attempt instead of each retrying it. See https://github.com/AdamTovatt/easy-reasy/blob/auth-client-v$(VersionPrefix)/EasyReasy.Auth.Client/README.md#from-180</PackageReleaseNotes>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
