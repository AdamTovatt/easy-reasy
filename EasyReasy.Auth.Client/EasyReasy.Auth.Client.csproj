<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth.Client</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>Minimal client only library for EasyReasy.Auth</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <VersionPrefix>2.0.0</VersionPrefix>
    <PackageReleaseNotes>Breaking. Authorization outcomes that retrying the same request will not change are now one exception family under AuthClientException: the new SignInRefusedException, with StatusCode, for a refused sign-in, replacing UnauthorizedAccessException and the HttpRequestException other refusals threw; the new SessionNotRenewableException for a client built from an AuthResponse whose refresh token is missing or refused, replacing InvalidOperationException; and InvalidAuthResponseException. A server that fails rather than refuses still throws HttpRequestException, now with StatusCode set, and a refresh answered that way keeps the refresh token. Calls waiting on authorization share one failed sign-in or refresh attempt instead of each retrying it. Messages are rewritten. See https://github.com/AdamTovatt/easy-reasy/blob/auth-client-v$(VersionPrefix)/EasyReasy.Auth.Client/README.md#from-180</PackageReleaseNotes>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
