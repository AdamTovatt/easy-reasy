<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth.Microsoft</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>Sign in with Microsoft work and school accounts for EasyReasy.Auth, through the server-side authorization code flow with PKCE, with per-request tenant, freshness and Conditional Access authentication context checks</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <PackageTags>auth;jwt;microsoft;entra;azuread;oidc;signin;easyreasy</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <VersionPrefix>1.0.0</VersionPrefix>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReleaseNotes>First release: Microsoft sign-in for work and school accounts through the server-side authorization code flow with PKCE, a browser-bound encrypted state, ID token validation against Microsoft's signing keys, tenant rules, and per-request max authentication age and Conditional Access authentication context checks, with the sign-in endpoints POST /api/auth/microsoft/begin and POST /api/auth/microsoft reporting every attempt to the audit logger. An app's own flows also get the validated raw ID token on the completion result, as signing evidence to seal with a record and never log. Requires EasyReasy.Auth 5.14.0. See https://github.com/AdamTovatt/easy-reasy/blob/auth-microsoft-v$(VersionPrefix)/EasyReasy.Auth.Microsoft/README.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyReasy.Auth.Microsoft.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The same version EasyReasy.Auth references, so the IdentityModel family resolves at one version
         (IdentityModelVersionAlignmentTests, linked into the test project, fails if they drift apart). -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.19.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyReasy.Auth\EasyReasy.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
