<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth.Saml</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>SAML 2.0 service-provider sign-in for EasyReasy.Auth: SP-initiated sign-in, the AuthnRequest over HTTP-Redirect and the response posted to the assertion consumer service, with pinned identity provider certificates, a signed assertion required, its request answered once in the browser that began it, persistent NameID or attribute identities, and re-check rules for ForceAuthn, authentication age and context class, with XML signatures and decryption by ITfoxtec.Identity.Saml2</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <PackageTags>auth;jwt;saml;saml2;sso;signin;easyreasy</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- A preview until a security review by someone who did not write it. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReleaseNotes>First preview: SAML 2.0 service-provider sign-in for EasyReasy.Auth. Requires EasyReasy.Auth 5.19.0. See https://github.com/AdamTovatt/easy-reasy/blob/auth-saml-v$(VersionPrefix)-$(VersionSuffix)/EasyReasy.Auth.Saml/README.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyReasy.Auth.Saml.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- 4.22.2 and 4.22.3 carry security fixes to SAML message processing; never go below 4.22.3. -->
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.22.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyReasy.Auth\EasyReasy.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
