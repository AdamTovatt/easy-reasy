<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>EasyReasy.Auth.OpenIdConnect</Title>
    <Authors>Adam Tovatt</Authors>
    <Description>Sign in with any OpenID Connect provider (Okta, Ping, Google Workspace, Keycloak) for EasyReasy.Auth, through the server-side authorization code flow with PKCE, with providers resolved per request and per-request freshness, acr and amr checks</Description>
    <Copyright>MIT</Copyright>
    <PackageProjectUrl>https://github.com/AdamTovatt/easy-reasy</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdamTovatt/easy-reasy</RepositoryUrl>
    <PackageTags>auth;jwt;oidc;openid;openidconnect;oauth;signin;sso;easyreasy</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <VersionPrefix>1.0.0-preview.1</VersionPrefix>
    <PackageIcon>BaseIcon.png</PackageIcon>
    <PackageReleaseNotes>First preview: sign-in with any OpenID Connect provider through the server-side authorization code flow with PKCE, and the shared flow EasyReasy.Auth.Microsoft is built on. A preview until a security review by someone who did not write it. Requires EasyReasy.Auth 5.18.0. See https://github.com/AdamTovatt/easy-reasy/blob/auth-openidconnect-v$(VersionPrefix)/EasyReasy.Auth.OpenIdConnect/README.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icons\PNG\Normal\128w\BaseIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyReasy.Auth.OpenIdConnect.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- No IdentityModel reference of its own: EasyReasy.Auth brings the whole family at one version, which
         IdentityModelVersionAlignmentTests, linked into the test project, guards. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyReasy.Auth\EasyReasy.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
